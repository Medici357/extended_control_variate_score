    "      f\"at t_hi={t_hi:.3g}: {tuple(round(float(v),4) for v in ab_of(t_hi))}\")\n",
    "print(f\"mode occupancy of fresh sample: \"\n",
    "      f\"{torch.bincount(gmm.nearest_mode(_smp), minlength=M).float().div(len(_smp)).cpu().numpy().round(2)}\")"
   ]
