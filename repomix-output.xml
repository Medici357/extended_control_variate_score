        self.nll_integration_method = nll_integration_method

        self.energy_function = energy_function
        self.noise_schedule = noise_schedule
        self.buffer = buffer
        self.dim = self.energy_function.dimensionality

        # The training/sampling pipeline is VE-only (a(t)=1): the forward noising, the
        # IS proposal, TSI/DSI, VEReverseSDE and the prior all assume it.
        assert not hasattr(noise_schedule, "a"), (
            "DEMLitModule assumes a VE noise schedule (a(t)=1); the provided "
            "schedule defines a scaling a(t)."
        )

        # Diffusion time interval is [0, time_range]; the reverse SDE starts
        # at t = time_range and the prior scale is derived from h(time_range)
        # in setup(), so changing the starting noise level stays consistent.
        self.time_range = time_range

        self.reverse_sde = VEReverseSDE(self.net, self.noise_schedule)

        if use_cvsi:
